# Optional: set your Hugging Face token here instead of in the UI Settings panel.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional overrides
# HF_MODEL=deepseek-ai/DeepSeek-V3-0324
# HF_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# HF_URL=https://router.huggingface.co/v1/chat/completions

# Paywall — paywall stays DISABLED until SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are both set.
# Docs: docs/DODO_PAYWALL_SETUP.md
# SUPABASE_URL=your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ…
#
# Dodo Payments (live): https://api.dodopayments.com  (test: https://test.dodopayments.com)
# API key: Dodo dashboard → Settings → API Keys (live mode, sk_live / key with dot)
# Product id: the subscription product's external_id (live environment)
# Webhook: create endpoint → https://<your-domain>/api/webhooks/dodo → copy signing secret
# DODO_API_BASE=https://api.dodopayments.com
# DODO_PAYMENTS_API_KEY=
# DODO_SUBSCRIPTION_PRODUCT_ID=
# DODO_WEBHOOK_KEY=